<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="FacialEmotionRecognitionHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:FacialEmotionRecognitionHub"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FacialEmotionRecognitionHub">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar"
                  Title="Facial Emotion Recognition Hub"
                  IsBackButtonVisible="False"
                  IsBackButtonEnabled="False">
        </TitleBar>
        <TabView x:Name="MainTabView"
                 CanDragTabs="True"
                 TabCloseRequested="MainTabView_TabCloseRequested"
                 AddTabButtonClick="MainTabView_AddTabButtonClickAsync"
                 Grid.Row="1"
                 TabItemsSource="{x:Bind VM.TabViewItems}"
                 SelectedItem="{x:Bind VM.SelectedTabViewItem, Mode=TwoWay}"
                 TabWidthMode="Equal"
                 VerticalAlignment="Stretch">
        </TabView>
    </Grid>
</Window>
