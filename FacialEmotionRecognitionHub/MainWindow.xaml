<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="FacialEmotionRecognitionHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:FacialEmotionRecognitionHub"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FacialEmotionRecognitionHub">

    <!--<Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>-->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar"
                  Title="Facial Emotion Recognition Hub"
                  IsBackButtonVisible="False">
            <!--<TitleBar.IconSource>
                <FontIconSource Glyph="&#xF4AA;" />
            </TitleBar.IconSource>-->
        </TitleBar>
        <!-- App content -->
        <!--<Frame x:Name="rootFrame" Grid.Row="1"/>-->
        <!--<Frame x:Name="rootFrame" Grid.Row="1" SourcePageType="views:NotePage"/>-->
        <!--<Frame x:Name="rootFrame"
               Grid.Row="1" />-->
        <TabView x:Name="MainTabView"
                 AllowDropTabs="True"
                 TabCloseRequested="MainTabView_TabCloseRequested"
                 Grid.Row="1"><!--CanTearOutTabs="True"-->
            <TabViewItem Header="首页"
                         Content="欢迎使用我的应用！"
                         CanDrag="False"
                         IsClosable="False"/>
            <TabViewItem Header="设置"
                         Content="个性化配置选项" />
            <TabViewItem Header="关于"
                         Content="版本信息和帮助" />
        </TabView>
    </Grid>
</Window>
