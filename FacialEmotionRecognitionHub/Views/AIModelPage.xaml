<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="FacialEmotionRecognitionHub.Views.AIModelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:FacialEmotionRecognitionHub.Views"
      xmlns:models="using:FacialEmotionRecognitionHub.Bus.Models"
      xmlns:viewmodels="using:FacialEmotionRecognitionHub.Bus.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      VerticalAlignment="Stretch"
      Height="Auto">
    <Page.Resources>
        <DataTemplate x:Key="IntTemplate"
                      x:DataType="models:IntParameter">
            <NumberBox Header="{x:Bind Header}"
                       Value="{x:Bind Value, Mode=TwoWay}"
                       SpinButtonPlacementMode="Compact"
                       SmallChange="1"
                       Margin="0,0,0,12" />
        </DataTemplate>

        <DataTemplate x:Key="FloatTemplate"
                      x:DataType="models:FloatParameter">
            <NumberBox Header="{x:Bind Header}"
                       Value="{x:Bind Value, Mode=TwoWay}"
                       SmallChange="0.01"
                       Margin="0,0,0,12" />
        </DataTemplate>

        <DataTemplate x:Key="BoolTemplate"
                      x:DataType="models:BoolParameter">
            <ToggleSwitch Header="{x:Bind Header}"
                          IsOn="{x:Bind Value, Mode=TwoWay}"
                          Margin="0,0,0,12" />
        </DataTemplate>

        <DataTemplate x:Key="PathTemplate"
                      x:DataType="models:PathParameter">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{x:Bind Header}" />
                <TextBox Grid.Column="0"
                         Grid.Row="1"
                         Text="{x:Bind Value, Mode=TwoWay}"
                         HorizontalAlignment="Stretch" />
                <!--Header="{x:Bind Header}"-->
                <!--<Button Grid.Column="1"
                        Content="Browse..."
                        Margin="8,18,0,0" />-->
                <Button Grid.Column="1"
                        Grid.Row="1"
                        Margin="8,0,0,0"
                        Click="{x:Bind Button_Click}">
                    <FontIcon Glyph="&#xE8B7;" />
                </Button>
            </Grid>
        </DataTemplate>

        <models:ParameterTemplateSelector x:Key="ParamSelector"
                                          IntTemplate="{StaticResource IntTemplate}"
                                          FloatTemplate="{StaticResource FloatTemplate}"
                                          BoolTemplate="{StaticResource BoolTemplate}"
                                          PathTemplate="{StaticResource PathTemplate}" />

        <DataTemplate x:Key="PivotTemplate"
                      x:DataType="viewmodels:PivotItemVM">
            <!--<PivotItem Header="{x:Bind Name}">-->
            <Grid Padding="4"
                  VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"
                                      MaxWidth="300"/>
                    <ColumnDefinition Width="5*" />
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Stretch"
                      Grid.Column="0"
                      Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">  <!--CornerRadius="8"-->
                        <StackPanel Spacing="16">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Padding="16"
                                    CornerRadius="8,8,0,0">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Hyperparameters"
                                               Style="{StaticResource SubtitleTextBlockStyle}" />

                                    <ItemsControl x:Name="ParamsControl"
                                                  ItemTemplateSelector="{StaticResource ParamSelector}"
                                                  ItemsSource="{x:Bind Parameters}"
                                                  Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="0,0,8,8"
                            Padding="16"
                            Grid.Row="1"
                            VerticalAlignment="Bottom"
                            Margin="0,12,0,0">
                        <StackPanel Spacing="12">
                            <!--<TextBlock Text="Control Panel"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />-->
                            <!--<TextBlock x:Name="TrainingStatusTxt"
                                           Text="Status: Idle"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           FontWeight="Bold" />-->
                            <!--<ProgressBar IsIndeterminate="False"
                                         Value="0"
                                         Margin="0,4,0,8"
                                         x:Name="TrainingProgressBar" />-->

                            <Button Content="EXECUTE"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ExecuteCommand}"/>
                            <!--Click="StartTrainingButton_Click"-->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PauseOrResume"
                                        Grid.Column="0"
                                        Content="{x:Bind PageVM.PromptShowed, Mode=OneWay}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,6,0"
                                        Command="{x:Bind PageVM.PauseOrResumeCommand}"/>
                                <!--Click="PauseTrainingButton_Click"-->
                                <Button Grid.Column="1"
                                        Content="Terminate"
                                        Foreground="Red"
                                        HorizontalAlignment="Stretch"
                                        Margin="6,0,0,0"
                                        Command="{x:Bind PageVM.TerminateCommand}"/>
                                <!--Click="TerminateTrainingButton_Click"-->
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Column="1"
                      Background="#1E1E1E"
                      CornerRadius="8"
                      Padding="16"
                      VerticalAlignment="Stretch">
                    <!--<Grid>-->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Console Output"
                               Foreground="#888888"
                               FontFamily="Consolas"
                               FontSize="12"
                               Margin="0,0,0,8" />
                    <ScrollViewer x:Name="ConsoleScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  Loaded="ConsoleScrollViewer_Loaded">
                        <TextBlock x:Name="TerminalBlock"
                                   Text="{x:Bind PageVM.Console, Mode=OneWay}"
                                   Foreground="White"
                                   FontFamily="Consolas"
                                   FontSize="13"
                                   LineHeight="20"
                                   SizeChanged="TerminalBlock_SizeChanged"/>
                        <!--Text="[INFO] Terminal initialized. Waiting for train() execution...&#x0a;[IDLE] Ready.&#x0a;>>>TEST OUTPUT."-->
                    </ScrollViewer>
                    <!--</Grid>-->
                </Grid>
            </Grid>
            <!--</PivotItem>-->
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32"
          Height="Auto"
          VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20"
                    Spacing="4">
            <TextBlock Text="{x:Bind VM.ModelName}"
                       Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind VM.Status, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                       HorizontalAlignment="Right" />
            <ProgressBar x:Name="ModelProgessBar"
                         Value="{x:Bind VM.Value, Mode=OneWay}"
                         IsIndeterminate="{x:Bind VM.IsIndeterminate, Mode=OneWay}"
                         ShowError="{x:Bind VM.ShowError, Mode=OneWay}"
                         ShowPaused="{x:Bind VM.ShowPaused, Mode=OneWay}"
                         Background="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>

        <!--<Pivot Grid.Row="1"
               Margin="-12,0,-12,0"
               ItemsSource="{x:Bind VM.PivotItemVMs}"
               ItemTemplate="{StaticResource PivotTemplate}" />-->
        <Pivot x:Name="__Pivot"
               Grid.Row="1"
               Margin="-12,0,-12,0"
               ItemsSource="{x:Bind VM.PivotItemVMs}"
               ItemTemplate="{StaticResource PivotTemplate}"
               VerticalAlignment="Stretch">
            <!--<Pivot.Transitions>
                <TransitionCollection>
                    
                </TransitionCollection>
            </Pivot.Transitions>-->
            <Pivot.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </Pivot.HeaderTemplate>
        </Pivot>

        <!--<Grid Background="#FFFFFF"
              Width="100"
              HorizontalAlignment="Right" 
              Grid.Row="1"
              Height="Auto"
              VerticalAlignment="Stretch"
              CornerRadius="8"
              Padding="16" />-->

    </Grid>

</Page>
