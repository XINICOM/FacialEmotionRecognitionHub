<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="FacialEmotionRecognitionHub.Views.AIModelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:FacialEmotionRecognitionHub.Views"
      xmlns:models="using:FacialEmotionRecognitionHub.Bus.Models"
      xmlns:viewmodels="using:FacialEmotionRecognitionHub.Bus.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <Page.Resources>
        <DataTemplate x:Key="IntTemplate"
                      x:DataType="models:IntParameter">
            <NumberBox Header="{x:Bind Header}"
                       Value="{x:Bind Value, Mode=TwoWay}"
                       SpinButtonPlacementMode="Compact"
                       SmallChange="1"
                       Margin="0,0,0,12" />
        </DataTemplate>

        <DataTemplate x:Key="FloatTemplate"
                      x:DataType="models:FloatParameter">
            <NumberBox Header="{x:Bind Header}"
                       Value="{x:Bind Value, Mode=TwoWay}"
                       SmallChange="0.01"
                       Margin="0,0,0,12" />
        </DataTemplate>

        <DataTemplate x:Key="BoolTemplate"
                      x:DataType="models:BoolParameter">
            <ToggleSwitch Header="{x:Bind Header}"
                          IsOn="{x:Bind Value, Mode=TwoWay}"
                          Margin="0,0,0,12" />
        </DataTemplate>

        <DataTemplate x:Key="PathTemplate"
                      x:DataType="models:PathParameter">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{x:Bind Header}" />
                <TextBox Grid.Column="0"
                         Grid.Row="1"
                         Text="{x:Bind Value, Mode=TwoWay}"
                         HorizontalAlignment="Stretch" />
                <!--Header="{x:Bind Header}"-->
                <!--<Button Grid.Column="1"
                        Content="Browse..."
                        Margin="8,18,0,0" />-->
                <Button Grid.Column="1"
                        Grid.Row="1"
                        Margin="8,0,0,0">
                    <FontIcon Glyph="&#xE8B7;" />
                </Button>
            </Grid>
        </DataTemplate>

        <models:ParameterTemplateSelector x:Key="ParamSelector"
                                          IntTemplate="{StaticResource IntTemplate}"
                                          FloatTemplate="{StaticResource FloatTemplate}"
                                          BoolTemplate="{StaticResource BoolTemplate}"
                                          PathTemplate="{StaticResource PathTemplate}" />

        <DataTemplate x:Key="PivotTemplate"
                      x:DataType="viewmodels:PivotItemVM">
            <!--<PivotItem Header="{x:Bind Name}">-->
            <Grid Padding="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,0,20,0">
                    <StackPanel Spacing="16">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Hyperparameters"
                                           Style="{StaticResource SubtitleTextBlockStyle}" />

                                <ItemsControl x:Name="ParamsControl"
                                              ItemTemplateSelector="{StaticResource ParamSelector}"
                                              ItemsSource="{x:Bind Parameters}"
                                              Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Control Panel"
                                           Style="{StaticResource SubtitleTextBlockStyle}" />
                                
                                <!--<TextBlock x:Name="TrainingStatusTxt"
                                           Text="Status: Idle"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           FontWeight="Bold" />-->
                                <ProgressBar IsIndeterminate="False"
                                             Value="0"
                                             Margin="0,4,0,8"
                                             x:Name="TrainingProgressBar" />

                                <Button Content="EXECUTE"
                                        Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch" />
                                <!--Click="StartTrainingButton_Click"-->
                                <Grid ColumnDefinitions="*, *">
                                    <Button x:Name="Pause"
                                            Grid.Column="0"
                                            Content="Pause"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,0,6,0"
                                            IsEnabled="False" />
                                    <!--Click="PauseTrainingButton_Click"-->
                                    <Button Grid.Column="1"
                                            Content="Terminate"
                                            Foreground="Red"
                                            HorizontalAlignment="Stretch"
                                            Margin="6,0,0,0" />
                                    <!--Click="TerminateTrainingButton_Click"-->
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Column="1"
                        Background="#1E1E1E"
                        CornerRadius="8"
                        Padding="16">
                    <Grid RowDefinitions="Auto, *">
                        <TextBlock Grid.Row="0"
                                   Text="Console stdout output"
                                   Foreground="#888888"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Margin="0,0,0,8" />
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TerminalBlock"
                                       Text="[INFO] Terminal initialized. Waiting for train() execution...&#x0a;[IDLE] Ready."
                                       Foreground="White"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       LineHeight="20" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
            <!--</PivotItem>-->
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20"
                    Spacing="4">
            <TextBlock Text="{x:Bind VM.ModelName}"
                       Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind VM.Status}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                       HorizontalAlignment="Right"/>
            <ProgressBar x:Name="ModelProgessBar"
                         Value="{x:Bind VM.Value}"
                         IsIndeterminate="{x:Bind VM.IsIndeterminate}"
                         ShowError="{x:Bind VM.ShowError}"
                         ShowPaused="{x:Bind VM.ShowPaused}"
                         Background="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>

        <!--<Pivot Grid.Row="1"
               Margin="-12,0,-12,0"
               ItemsSource="{x:Bind VM.PivotItemVMs}"
               ItemTemplate="{StaticResource PivotTemplate}" />-->
        <Pivot Grid.Row="1"
               Margin="-12,0,-12,0"
               ItemsSource="{x:Bind VM.PivotItemVMs}"
               ItemTemplate="{StaticResource PivotTemplate}">
            <!--<Pivot.Transitions>
                <TransitionCollection>
                    
                </TransitionCollection>
            </Pivot.Transitions>-->
            <Pivot.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </Pivot.HeaderTemplate>
        </Pivot>



    </Grid>

</Page>
