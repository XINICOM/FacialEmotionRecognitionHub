    <Page.Resources>
        <DataTemplate x:Key="DashboardItemTmplate"
                      x:DataType="models:AIModelM">
            <ItemContainer>
                <Border Width="300"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="6">
                            <TextBlock Text="{x:Bind Name}"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                            <!--<Border Background="{ThemeResource SystemControlHighlightAccentBrush}"
                                    CornerRadius="4"
                                    Padding="6,2,6,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="BEST"
                                           FontSize="10"
                                           Foreground="White"
                                           FontWeight="Bold"/>
                            </Border>-->
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Text="{x:Bind Status}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="Gray"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,12" />
                        
                        <ProgressBar Grid.Row="2"
                                     Value="{x:Bind Value}"
                                     IsIndeterminate="{x:Bind IsIndeterminate}"
                                     ShowError="{x:Bind ShowError}"
                                     ShowPaused="{x:Bind ShowPaused}"
                                     Background="LightGray" />
                        
                        <StackPanel Grid.Row="3"
                                    Margin="0,12,0,0"
                                    Spacing="16">
                            <!--<StackPanel>-->
                                <TextBlock Text="Validation Accuracy"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                <TextBlock Text="87.5%"
                                           Style="{StaticResource DisplayTextBlockStyle}"
                                           Foreground="Green" />
                            <!--</StackPanel>-->
                            <!--<StackPanel>
                                <TextBlock Text="Inference Latency (Per Frame)"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
