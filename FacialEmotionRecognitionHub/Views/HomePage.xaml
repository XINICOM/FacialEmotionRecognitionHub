            </ItemContainer>
        </DataTemplate>
    </Page.Resources>
    
    <ItemsView Margin="4,4,4,4"
               ItemTemplate="{StaticResource DashboardItemTmplate}"
               ItemsSource="{x:Bind VM.AIModelMs}"
               SelectionMode="None"
               IsItemInvokedEnabled="True"><!--ItemInvoked="ItemsView_ItemInvoked"-->
        <ItemsView.Layout>
            <UniformGridLayout MinItemWidth="300"
                               MinColumnSpacing="16"
                               MinRowSpacing="16"
                               ItemsJustification="Start" />
        </ItemsView.Layout>
